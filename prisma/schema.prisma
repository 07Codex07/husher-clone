generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Order {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  type           String   // "exchange" | "multi" | "private" | "batch"
  fromCurrency   String
  toCurrency     String
  fromAmountUnits BigInt  // amount in the currency's smallest unit (satoshis, wei, etc.)
  toAmountUnits   BigInt?
  quotedRate     Float    // display/reference only — never used for settlement math
  provider       String
  providerOrderId String? // id assigned by the upstream exchange provider (e.g. Husher)
  depositAddress String?
  payoutAddress  String?  // null for multi/batch orders (recipients live in meta)
  txHash         String?
  externalUserId String?
  failureReason  String?
  meta           Json?    // multi: recipients; batch: addresses; last upstream snapshot
  expiresAt      DateTime? // unfunded orders past this are marked expired by the worker
  lastPolledAt   DateTime?
  status         String   @default("pending")
  // awaiting_deposit, confirming, exchanging, completed, failed, expired (see src/lib/status.js)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([providerOrderId])
  @@index([externalUserId])
}