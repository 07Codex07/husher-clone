DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/husher?retryWrites=true&w=majority"
PORT=3000
NODE_ENV=development
HUSHER_API_KEY=
HUSHER_API_URL=https://api.husher.net
# mock = safe, in-memory, no real trades. husher = hits the live API with HUSHER_API_KEY above.
EXCHANGE_PROVIDER=mock

# Comma-separated keys accepted on /api/orders. Unset = any non-empty key (dev only);
# the server refuses to start with NODE_ENV=production and this unset.
ORDERS_API_KEYS=

# Optional. With Redis the status worker runs on BullMQ and order events fan out
# across instances (docker compose up -d redis). Unset = in-process worker + events.
# In production a set-but-unreachable Redis is a startup error.
REDIS_URL=

# Background status poller: interval in ms, or WORKER=off to disable.
WORKER_INTERVAL_MS=5000
# BullMQ only: how many order refreshes run at once per instance.
WORKER_CONCURRENCY=5
# Unfunded orders older than this are marked expired.
ORDER_EXPIRY_MINUTES=30
