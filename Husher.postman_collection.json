{
  "info": {
    "name": "Husher API (local mock)",
    "description": "Every endpoint is served by the mock backend in src/server.js — no database, no upstream calls. Order statuses advance on their own over ~65s, so you can poll a status endpoint and watch pending -> confirming -> exchanging -> completed.\n\nCollection variables:\n- baseUrl: http://localhost:3000\n- apiKey: any non-empty string (sent as x-api-key on every request)\n\nReset all in-memory state with 'Mock control > POST _mock/reset'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "apiKey", "value": "demo-key" }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-api-key" },
      { "key": "value", "value": "{{apiKey}}" },
      { "key": "in", "value": "header" }
    ]
  },
  "item": [
    {
      "name": "Exchange",
      "item": [
        {
          "name": "GET rate",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/husher/rate?sendToken=USDT&receiveToken=BNB&amountType=send&sendAmount=100&sendNetwork=BSC&receiveNetwork=BSC&provider=floating",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "husher", "rate"],
              "query": [
                { "key": "sendToken", "value": "USDT" },
                { "key": "receiveToken", "value": "BNB" },
                { "key": "amountType", "value": "send" },
                { "key": "sendAmount", "value": "100" },
                { "key": "receiveAmount", "value": "", "disabled": true },
                { "key": "sendNetwork", "value": "BSC" },
                { "key": "receiveNetwork", "value": "BSC" },
                { "key": "provider", "value": "floating" },
                { "key": "markup", "value": "", "disabled": true },
                { "key": "externalUserId", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "GET currencies",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/husher/currencies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "husher", "currencies"]
            }
          }
        },
        {
          "name": "POST create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"send\": \"USDT\",\n  \"sendNetwork\": \"BSC\",\n  \"receive\": \"BNB\",\n  \"receiveNetwork\": \"BSC\",\n  \"amount\": 100,\n  \"receiveAddress\": \"0xYourAddressHere\",\n  \"ipAddress\": \"203.45.67.89\",\n  \"externalUserId\": \"user_001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/husher/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "husher", "create"]
            }
          }
        },
        {
          "name": "GET status/{transactionId}",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/husher/status/kX9mP2nQ",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "husher", "status", "kX9mP2nQ"]
            }
          }
        }
      ]
    },
